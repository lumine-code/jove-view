{
  "name": "jove-view",
  "author": "lumine-code",
  "description": "Open and edit Jupyter notebooks",
  "repository": "https://github.com/lumine-code/jove-view",
  "bugs": {
    "url": "https://github.com/lumine-code/jove-view/issues"
  },
  "homepage": "https://github.com/lumine-code/jove-view#readme",
  "keywords": [
    "jupyter",
    "notebook",
    "ipynb",
    "python",
    "editor"
  ],
  "version": "2.1.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../jove-view/spec",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "deserializers": {
    "JoveNotebookEditor": "deserializeNotebookEditor"
  },
  "consumedServices": {
    "tree-view": {
      "versions": {
        "1.0.0": "consumeTreeView"
      }
    },
    "simplemap": {
      "versions": {
        "1.0.0": "consumeSimpleMap"
      }
    }
  },
  "providedServices": {
    "jove.notebook": {
      "versions": {
        "1.0.0": "provideJoveNotebook"
      }
    },
    "jove.adapter": {
      "versions": {
        "1.0.0": "provideJoveAdapter"
      }
    },
    "linter-adapter": {
      "versions": {
        "1.0.0": "provideLinterItemAdapter"
      }
    },
    "linter-ui": {
      "versions": {
        "1.0.0": "provideLinterUI"
      }
    },
    "navigation-adapter": {
      "versions": {
        "1.0.0": "provideNavigationAdapter"
      }
    },
    "search-adapter": {
      "versions": {
        "1.0.0": "provideSearchAdapter"
      }
    }
  },
  "dependencies": {
    "@mathjax/src": "^4.0.0",
    "anser": "^2.3.3",
    "plotly.js-dist": "^3.6.0",
    "uuid": "^11.1.0"
  },
  "configSchema": {
    "notebook": {
      "title": "Notebook",
      "description": "Notebook-level settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "useOpener": {
          "title": "Use Workspace Opener",
          "description": "Open .ipynb files with jove-view through the Lumine workspace opener.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "input": {
      "title": "Input Cell",
      "description": "Input cell display and editing settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "maxHeight": {
          "title": "Max Height",
          "description": "Maximum height in pixels for input cells. Zero means unlimited.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "output": {
      "title": "Output Cell",
      "description": "Output cell display settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "maxHeight": {
          "title": "Max Height",
          "description": "Maximum height in pixels for output cells before scrolling.",
          "type": "integer",
          "minimum": 100,
          "default": 1000
        }
      }
    },
    "scrollmap": {
      "title": "Scrollmap",
      "description": "Scrollmap marker settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "enabled": {
          "title": "Show Scrollmap",
          "description": "Show markdown heading and selected cell markers on the notebook scrollbar when the scrollmap package is available.",
          "type": "boolean",
          "default": true
        },
        "threshold": {
          "title": "Threshold",
          "description": "Hide scrollmap markers if their count exceeds this value. Zero means no limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "depth": {
          "title": "Depth",
          "description": "Maximum markdown heading depth to show in the scrollmap. Zero means no limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
